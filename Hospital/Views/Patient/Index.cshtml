@model Hospital.ViewModels.PatientViewModel

@{
    ViewData["Title"] = "Patient Page";
}

<html>
<head>

</head>
<body>
    <div class="patient-header view-header">
        <h3>Patients</h3>
        <button class="button" type="button" onclick="location.href='@Url.Action("Create", "Patient")'">New Patient</button>

    </div>
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Patient ID</th>
                    <th>Name</th>
                    <th>DOB</th>
                    <th>Gender</th>
                    <th>Address</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Appointments</th>
                    <th>Actions</th>
                </tr>

            </thead>
            <tbody>
                @if (Model.Patients.Count == 0)
                {
                    <tr>
                        <td class="empty-table-row">No Patients available</td>
                    </tr>
                    <tr><td>test 1</td></tr>
                    <tr><td>test 2</td></tr>
                    <tr><td>test 3</td></tr>
                    <tr><td>test 3</td></tr>
                    <tr><td>test 5</td></tr>

                }
                else
                {
                    @foreach (var patient in Model.Patients)
                    {
                        <tr>
                            <td>@patient.ID</td>
                            <td>@patient.FirstName @patient.LastName</td>
                            <td>@patient.DateofBirth</td>
                            <td>@patient.Gender</td>
                            <td>@patient.Address</td>
                            <td>@patient.Email</td>
                            <td>@patient.Phone</td>
                            @if(patient.Appointments.Count == 0)
                            {
                                <td>No Appointments</td>
                            }
                            else
                            {
                                <td>@patient.Appointments</td>
                            }
                            <td class="actions-container">
                                <a class="button" onclick="location.href='@Url.Action("Edit", "Patient",new {id=patient.ID})'">Edit</a>
                                <a class="button" onclick="location.href='@Url.Action("Details", "Patient",new {id=patient.ID})'">Details</a>
                                <a class="button" onclick="location.href='@Url.Action("Delete", "Patient",new {id=patient.ID})'">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</body>
</html>